# Локальная конфигурация stats-backend-java. Скопируйте в .env и заполните
# своими значениями. .env в git не коммитится.

# Обязательно: секрет для шифрования сессионной cookie (openssl rand -hex 32).
STATS_SESSION_SECRET=

# Обязательно: JDBC-строка к PostgreSQL (не postgresql://..., а jdbc:postgresql://...).
DATABASE_URL_JDBC=jdbc:postgresql://localhost:5432/discordbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Порт (по умолчанию 8081).
STATS_BACKEND_JAVA_PORT=8081

# Riot (опционально — без них /auth/riot/login редиректит на /?auth_error=1,
# /api/riot/lookup возвращает 503).
# RIOT_CLIENT_ID=
# RIOT_CLIENT_SECRET=
# RIOT_API_KEY=

# Почта (опционально — без них регистрация вернёт internal_error на
# отправке кода подтверждения).
# STATS_MAIL_USER=
# STATS_MAIL_APP_PASSWORD=
# STATS_MAIL_FROM=
# Для локальной разработки можно направить на MailHog:
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025

# Cloudflare Turnstile (опционально — без него /auth/login вернёт
# turnstile_failed).
# TURNSTILE_SECRET_KEY=

# Белый список email через запятую — доступ к /admin/tickets.
# SUPPORT_ADMIN_EMAILS=