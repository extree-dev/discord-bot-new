<?xml version="1.0" encoding="UTF-8"?>
<!--
    Отдельный Maven-модуль, не часть корневого Node-проекта — осознанно:
    это первая фаза перехода stats-backend (Extree Stats) с Node/Express
    на Java с гексагональной архитектурой (порты/адаптеры), см. обсуждение
    в истории коммитов. Node-версия (../stats-backend/) остаётся рабочей и
    задеплоенной, пока этот сервис не покроет весь REST API и не будет
    сознательно переключён в docker-compose.yml/Caddyfile — ничего в проде
    этот модуль пока не меняет.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>tech.extree</groupId>
    <artifactId>stats-backend</artifactId>
    <version>0.1.0</version>
    <name>stats-backend</name>
    <description>Extree Stats backend — Java/hexagonal rewrite of stats-backend/ (Node)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Plain JDBC (JdbcTemplate), не JPA/Hibernate — схема (см.
             ../stats-backend/db.js) уже ручной SQL без ORM-разметки, и
             порты-адаптеры в этом проекте держат репозитории тонкими
             обёртками над SQL, а не маппингом сущностей. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway — миграции схемы (src/main/resources/db/migration/).
             Раньше схему создавал Node-овый db.js идемпотентным DDL; после
             перехода на Java это единственный источник схемы. baseline-on-migrate
             позволяет безопасно накатить baseline на прод, где таблицы уже
             созданы Node-ом — Flyway не будет пытаться пересоздать их, а
             запишет версию в flyway_schema_history.
             flyway-database-postgresql обязательна с Flyway 10+ для PostgreSQL
             15+ (без неё Flyway падает "Unsupported Database: PostgreSQL 16"). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Отправка писем с кодом подтверждения (../stats-backend/mailer.js
             использует nodemailer на тот же SMTP iCloud Mail). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Scrypt — стандартный JDK/JCE её не поставляет (в отличие от
             PBKDF2), а пароли уже захешированы Node'овым crypto.scryptSync
             (см. users.js) — нужна совместимая по параметрам (N=16384,
             r=8, p=1) реализация, а не замена схемы хеширования на
             несовместимую, иначе все существующие пароли пришлось бы
             сбрасывать. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>