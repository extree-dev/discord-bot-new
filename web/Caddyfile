# Caddy сам получает и продлевает TLS-сертификаты Let's Encrypt для
# доменов, перечисленных ниже — достаточно, чтобы их DNS A-записи
# указывали на этот VPS и были открыты порты 80/443 (80 — для
# ACME-challenge, 443 — сам HTTPS). Ручного certbot не требуется.
#
# bot.extree.tech — статика (web/bot-site/) отдаётся напрямую из рабочей
# копии репозитория (docker-compose.yml монтирует её в контейнер только
# на чтение) — обновление не требует пересборки образа, только git pull,
# который уже делает deploy.yml на каждый push в main.
#
# extree.tech целиком — React-SPA (frontend/, dashboard/server.js), там
# нет больше отдельной статики: и визитка ("/"), и её редактор ("/admin")
# рендерятся на клиенте, сервер отдаёт только собранные assets/*.js,
# assets/*.css и JSON под /api/*.
#
# stats.extree.tech — отдельный продукт (статистика VALORANT, Riot API),
# пока просто статическая заглушка (web/stats-site/), так же как
# bot-site — без своего Node-процесса. Сюда же, в корень web/stats-site/,
# при верификации домена в Riot Developer Portal кладётся их riot.txt —
# ничего менять в Caddy для этого не нужно, file_server отдаст любой файл
# из этой папки как есть.

extree.tech, www.extree.tech {
    reverse_proxy dashboard:3000
    encode gzip
}

bot.extree.tech {
    # Личный кабинет (dashboard/server.js) — отдельный Node-процесс в
    # том же docker-compose, сервис "dashboard", порт 3000 внутри сети
    # контейнеров. /assets/* — собранные JS/CSS того же React-SPA, что и
    # на extree.tech (один общий билд, frontend/dist/assets/), нужны
    # браузеру, чтобы отрендерить /dashboard. Остальной сайт (маркетинговая
    # статика бота) по-прежнему чистая статика из web/bot-site/.
    handle /auth/* {
        reverse_proxy dashboard:3000
    }
    handle /api/* {
        reverse_proxy dashboard:3000
    }
    handle /dashboard* {
        reverse_proxy dashboard:3000
    }
    handle /login* {
        reverse_proxy dashboard:3000
    }
    handle /assets/* {
        reverse_proxy dashboard:3000
    }
    # Техперерыв (см. dashboard/maintenancePage.js, тот же дизайн
    # продублирован здесь как web/bot-site/maintenance.html): эта статика
    # (web/bot-site/) — единственное на bot.extree.tech, что не проходит
    # через dashboard:3000 и потому не закрывается его MAINTENANCE_MODE
    # middleware. rewrite/header — внутри этого catch-all handle, а не на
    # уровне всего сайта: handle-блоки выше (/auth/*, /api/*, /dashboard*,
    # /login*, /assets/*) по-прежнему сначала проверяются как обычно и
    # уходят на dashboard:3000 (там их закрывает MAINTENANCE_MODE) — иначе
    # неадресный rewrite выполнился бы для всех путей раньше, чем Caddy
    # успеет сопоставить их с handle-блоками. Снова открыть маркетинговую
    # страницу бота: убрать rewrite/header ниже и передеплоить.
    handle {
        rewrite * /maintenance.html
        header Retry-After "3600"
        root * /srv/bot-site
        file_server {
            status 503
        }
    }
    encode gzip
}

stats.extree.tech {
    root * /srv/stats-site
    file_server
    encode gzip
}
