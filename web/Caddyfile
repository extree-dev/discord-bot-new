# Caddy сам получает и продлевает TLS-сертификаты Let's Encrypt для
# доменов, перечисленных ниже — достаточно, чтобы их DNS A-записи
# указывали на этот VPS и были открыты порты 80/443 (80 — для
# ACME-challenge, 443 — сам HTTPS). Ручного certbot не требуется.
#
# Статика отдаётся напрямую из рабочей копии репозитория (см.
# docker-compose.yml — каталоги web/site и web/bot-site примонтированы
# в контейнер только на чтение) — обновление сайта не требует пересборки
# образа, только git pull на сервере, который уже делает deploy.yml на
# каждый push в main.

extree.tech, www.extree.tech {
    root * /srv/site
    file_server
    encode gzip
}

bot.extree.tech {
    # Личный кабинет (dashboard/server.js) — отдельный Node-процесс в
    # том же docker-compose, сервис "dashboard", порт 3000 внутри сети
    # контейнеров. Только эти два префикса проксируются туда, остальной
    # сайт (в т.ч. сам /styles.css, которым пользуются и страницы
    # кабинета) по-прежнему чистая статика.
    handle /auth/* {
        reverse_proxy dashboard:3000
    }
    handle /dashboard* {
        reverse_proxy dashboard:3000
    }
    handle {
        root * /srv/bot-site
        file_server
    }
    encode gzip
}
