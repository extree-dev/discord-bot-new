# Caddy сам получает и продлевает TLS-сертификаты Let's Encrypt для
# доменов, перечисленных ниже — достаточно, чтобы их DNS A-записи
# указывали на этот VPS и были открыты порты 80/443 (80 — для
# ACME-challenge, 443 — сам HTTPS). Ручного certbot не требуется.
#
# bot.extree.tech — статика (web/bot-site/) отдаётся напрямую из рабочей
# копии репозитория (docker-compose.yml монтирует её в контейнер только
# на чтение) — обновление не требует пересборки образа, только git pull,
# который уже делает deploy.yml на каждый push в main.
#
# extree.tech целиком — React-SPA (frontend/, dashboard/server.js), там
# нет больше отдельной статики: и визитка ("/"), и её редактор ("/admin")
# рендерятся на клиенте, сервер отдаёт только собранные assets/*.js,
# assets/*.css и JSON под /api/*.
#
# stats.extree.tech — отдельный продукт (статистика VALORANT, Riot API,
# см. stats-frontend/): React-SPA с клиент-side роутингом
# (react-router-dom), раздаётся статикой из web/stats-site/ (как и
# bot-site), плюс теперь отдельный Node-процесс stats-backend (см.
# stats-backend/server.js) только для Riot Sign-On (RSO) — /auth/* и
# /api/* явными handle-блоками уходят туда, тот же порядок, что у
# bot.extree.tech ниже: явные handle-блоки проверяются раньше catch-all,
# иначе try_files внутри catch-all перехватил бы и их. try_files перед
# file_server в catch-all — обязательный SPA-fallback: без него прямой
# заход на stats.extree.tech/terms (не переход кликом внутри уже
# загруженного приложения) упёрся бы в 404, потому что файла terms.html
# на диске не существует — весь роутинг только в JS-бандле. riot.txt для
# верификации домена в Riot Developer Portal кладётся в корень
# web/stats-site/ — try_files находит реальный файл раньше фолбэка на
# index.html, так что на сам riot.txt это не влияет.

extree.tech, www.extree.tech {
    reverse_proxy dashboard:3000
    encode gzip
}

bot.extree.tech {
    handle /auth/* {
        reverse_proxy dashboard:3000
    }
    handle /api/* {
        reverse_proxy dashboard:3000
    }
    handle /dashboard* {
        reverse_proxy dashboard:3000
    }
    handle /login* {
        reverse_proxy dashboard:3000
    }
    handle /assets/* {
        reverse_proxy dashboard:3000
    }
    handle {
        rewrite * /maintenance.html
        header Retry-After "3600"
        root * /srv/bot-site
        file_server {
            status 503
        }
    }
    encode gzip
}

stats.extree.tech {
    handle /auth/* {
        reverse_proxy stats-backend-java:8081
    }
    handle /api/* {
        reverse_proxy stats-backend-java:8081
    }
    handle {
        root * /srv/stats-site
        try_files {path} /index.html
        file_server
    }
    encode gzip
}