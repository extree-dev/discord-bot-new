DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# ID пользователей через запятую, которым доверяет система безопасности
# (владелец сервера всегда доверенный автоматически)
TRUSTED_IDS=

# Строка подключения к PostgreSQL, где хранится вся конфигурация бота
# (security-config, tickets, temp-voice, warnings) — обязательна, бот не
# запустится без рабочего DATABASE_URL. Пример для локальной БД:
# postgresql://discordbot:discordbot@localhost:5432/discordbot
#
# При запуске через docker compose (см. docker-compose.yml) значение
# этой переменной переопределяется автоматически на адрес контейнера
# postgres — для локального запуска без Docker укажи её сам.
DATABASE_URL=

# Используются только docker-compose.yml для контейнера postgres —
# при обычном (не Docker) запуске можно не задавать, тогда применяются
# значения по умолчанию (discordbot/discordbot/discordbot).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Ключ неофициального HenrikDev API (valorantNews/) — публикует новости
# Valorant в #📬│game-news. Бесплатный, выдаётся через их Discord
# (discord.gg/X3GaVkX2YN → бот → "VALORANT (Basic Key)"). Без ключа фича
# просто молча простаивает, это не ошибка — см. valorantNews/model.js.
HENRIKDEV_API_KEY=

# Личный кабинет (bot.extree.tech/dashboard) + редактор визитки
# (extree.tech/admin) — вход через Discord OAuth2. Без этих переменных
# (и без GUILD_ID выше) процесс dashboard откажется стартовать (см.
# dashboard/server.js).
#
# DISCORD_CLIENT_SECRET — Discord Developer Portal → приложение бота →
# OAuth2 → Client Secret (кнопка "Reset Secret", если ещё не генерировался).
# SESSION_SECRET — случайная строка для шифрования cookie сессии
# (openssl rand -hex 32). Менять на проде — значит разлогинить всех разом.
#
# redirect_uri для OAuth2 дашборд теперь определяет сам по заголовку
# Host запроса (поддерживает оба домена одним процессом), отдельная
# переменная для него не нужна — зато в Discord Developer Portal →
# OAuth2 → Redirects должны быть зарегистрированы ОБА адреса:
# https://bot.extree.tech/auth/discord/callback
# https://extree.tech/auth/discord/callback
DISCORD_CLIENT_SECRET=
SESSION_SECRET=

# Необязательные запасные способы входа в тот же кабинет (не отдельная
# система прав — права по-прежнему проверяются по привязанному Discord-
# аккаунту, см. dashboard/accounts.js), нужны когда discord.com
# недоступен напрямую (блокировки и т.п.). Без них дашборд работает как
# раньше — просто кнопка Telegram не показывается, вход по email работает
# только для аккаунтов, уже привязавших пароль через настройки.
#
# TELEGRAM_BOT_TOKEN/TELEGRAM_BOT_USERNAME — создать бота через
# @BotFather (/newbot), затем в настройках бота → Login Widget указать
# домен bot.extree.tech (именно его, не extree.tech — виджет Telegram
# поддерживает только ОДИН домен на бота, это ограничение самого
# Telegram; кнопка на extree.tech/admin осознанно не показывается, см.
# frontend/src/shared/lib/isDashboardDomain.ts). Можно переиспользовать
# того же бота, которым уже управляется сервер Discord, — или завести
# отдельного специально для логина, это не связано с основным
# DISCORD_TOKEN.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
