DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# ID пользователей через запятую, которым доверяет система безопасности
# (владелец сервера всегда доверенный автоматически)
TRUSTED_IDS=

# Строка подключения к PostgreSQL, где хранится вся конфигурация бота
# (security-config, tickets, temp-voice, warnings) — обязательна, бот не
# запустится без рабочего DATABASE_URL. Пример для локальной БД:
# postgresql://discordbot:discordbot@localhost:5432/discordbot
#
# При запуске через docker compose (см. docker-compose.yml) значение
# этой переменной переопределяется автоматически на адрес контейнера
# postgres — для локального запуска без Docker укажи её сам.
DATABASE_URL=

# Используются только docker-compose.yml для контейнера postgres —
# при обычном (не Docker) запуске можно не задавать, тогда применяются
# значения по умолчанию (discordbot/discordbot/discordbot).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Ключ неофициального HenrikDev API (valorantNews/) — публикует новости
# Valorant в #📬│game-news. Бесплатный, выдаётся через их Discord
# (discord.gg/X3GaVkX2YN → бот → "VALORANT (Basic Key)"). Без ключа фича
# просто молча простаивает, это не ошибка — см. valorantNews/model.js.
HENRIKDEV_API_KEY=

# Личный кабинет (bot.extree.tech/dashboard) + редактор визитки
# (extree.tech/admin) — вход через Discord OAuth2. Без этих переменных
# (и без GUILD_ID выше) процесс dashboard откажется стартовать (см.
# dashboard/server.js).
#
# DISCORD_CLIENT_SECRET — Discord Developer Portal → приложение бота →
# OAuth2 → Client Secret (кнопка "Reset Secret", если ещё не генерировался).
# SESSION_SECRET — случайная строка для шифрования cookie сессии
# (openssl rand -hex 32). Менять на проде — значит разлогинить всех разом.
#
# redirect_uri для OAuth2 дашборд теперь определяет сам по заголовку
# Host запроса (поддерживает оба домена одним процессом), отдельная
# переменная для него не нужна — зато в Discord Developer Portal →
# OAuth2 → Redirects должны быть зарегистрированы ОБА адреса:
# https://bot.extree.tech/auth/discord/callback
# https://extree.tech/auth/discord/callback
DISCORD_CLIENT_SECRET=
SESSION_SECRET=

# Необязательные запасные способы входа в тот же кабинет (не отдельная
# система прав — права по-прежнему проверяются по привязанному Discord-
# аккаунту, см. dashboard/accounts.js), нужны когда discord.com
# недоступен напрямую (блокировки и т.п.). Без них дашборд работает как
# раньше — просто кнопка Telegram не показывается, вход по email работает
# только для аккаунтов, уже привязавших пароль через настройки.
#
# TELEGRAM_BOT_TOKEN/TELEGRAM_BOT_USERNAME — создать бота через
# @BotFather (/newbot), затем в настройках бота → Login Widget указать
# домен bot.extree.tech (именно его, не extree.tech — виджет Telegram
# поддерживает только ОДИН домен на бота, это ограничение самого
# Telegram; кнопка на extree.tech/admin осознанно не показывается, см.
# frontend/src/shared/lib/isDashboardDomain.ts). Можно переиспользовать
# того же бота, которым уже управляется сервер Discord, — или завести
# отдельного специально для логина, это не связано с основным
# DISCORD_TOKEN.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET — Google Cloud Console → APIs &
# Services → Credentials → Create Credentials → OAuth client ID (тип
# Web application). В Authorized redirect URIs зарегистрировать ОБА:
# https://bot.extree.tech/auth/google/callback
# https://extree.tech/auth/google/callback
# Как и Telegram/email выше — только запасной вход в уже существующий
# (созданный через Discord) аккаунт, без них кнопка Google просто не
# показывается.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET — GitHub → Settings → Developer
# settings → OAuth Apps → New OAuth App
# (https://github.com/settings/developers). В отличие от Google, у
# GitHub OAuth App ровно ОДИН "Authorization callback URL" на всё
# приложение — два домена (bot.extree.tech и extree.tech) в одну форму
# не впишешь, а текущий код — одна пара CLIENT_ID/CLIENT_SECRET на
# процесс, не по домену. Варианта два: зарегистрировать callback только
# на основной домен (ниже) и обслуживать вход через GitHub только там
# (как Telegram) — либо завести ДВЕ отдельные OAuth App, по одной на
# домен, и код дашборда доработать так, чтобы выбирать CLIENT_ID/SECRET
# по Host запроса, как redirectUriForGithub уже выбирает redirect_uri.
# Выбрали первый вариант — проще и не требует менять код.
# Authorization callback URL: https://bot.extree.tech/auth/github/callback
# Как и Telegram/email/Google выше — только запасной вход в уже
# существующий (созданный через Discord) аккаунт, без них кнопка GitHub
# просто не показывается.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Extree Stats (stats.extree.tech, stats-backend/) — отдельный продукт,
# не личный кабинет бота: своя заявка в Riot Developer Portal, свой
# Node-процесс (docker-compose.yml, сервис stats-backend), своя сессия
# (не связана с SESSION_SECRET/аккаунтами выше).
#
# RIOT_CLIENT_ID/RIOT_CLIENT_SECRET — Riot Developer Portal, доступно
# только ПОСЛЕ одобрения продукта: Riot сначала одобряет сам продукт
# (сейчас Pending Review), потом присылает ОТДЕЛЬНОЕ приглашение подать
# заявку на RSO (Riot Sign-On) — см. комментарий в начале
# stats-backend/riotOAuth.js, там же пометки про то, что ещё нужно
# свериться с реальной докой Riot (метод авторизации клиента — Client
# Secret Basic или Private Key JWT, PKCE, точный scope). Без этих двух
# переменных stats-backend всё равно стартует — /auth/riot/login просто
# честно отвечает ошибкой вместо похода в Riot с пустым client_id.
#
# STATS_SESSION_SECRET — случайная строка для шифрования cookie сессии
# Extree Stats (openssl rand -hex 32), обязательна: без неё stats-backend
# не стартует. Намеренно отдельная от SESSION_SECRET дашборда — сессии
# двух разных продуктов не должны быть криптографически связаны.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=

# RIOT_API_KEY — личный (development) ключ с developer.riotgames.com,
# НЕ связан с RIOT_CLIENT_ID/SECRET выше (тот — для RSO-входа, этот — для
# прямых запросов к Riot API). Доступен сразу, без одобрения продукта, но
# истекает каждые 24 часа и нужно будет перевыпускать вручную, пока Riot
# не выдаст постоянный production-ключ. Сейчас используется только для
# account-v1 (stats-backend/riotApi.js, поиск по Riot ID → PUUID) — доступа
# к VALORANT Match-V1 (сами матчи) у личного ключа нет, см. комментарий
# в riotApi.js.
RIOT_API_KEY=
STATS_SESSION_SECRET=

# Почта для писем с кодом подтверждения при регистрации (email+пароль,
# см. stats-backend/mailer.js) — отдельный iCloud-ящик, заведённый
# специально под Extree Stats, не Resend бота (utils/email.js).
# STATS_MAIL_USER — полный адрес (например, extreestats@icloud.com).
# STATS_MAIL_APP_PASSWORD — НЕ обычный пароль Apple ID: сгенерировать на
# appleid.apple.com → Sign-In and Security → App-Specific Passwords.
# STATS_MAIL_FROM — необязательно, по умолчанию "Extree Stats
# <STATS_MAIL_USER>".
STATS_MAIL_USER=
STATS_MAIL_APP_PASSWORD=
STATS_MAIL_FROM=

# Cloudflare Turnstile на /login (stats-backend/turnstile.js) — только
# Secret Key: Site Key публичный и зашит прямо в stats-frontend (не
# секрет, как и у любой капчи). Создаётся в Cloudflare dashboard →
# Turnstile для домена stats.extree.tech.
TURNSTILE_SECRET_KEY=

# Мониторинг ошибок stats-backend (Sentry, проект stats-backend в
# организации extree-stats). DSN не секрет — в server.js уже зашит как
# дефолт, эта переменная только переопределяет его на случай второго
# окружения/временного отключения (пустая строка отключать не будет,
# см. комментарий в server.js — тогда просто не задавай переменную).
STATS_BACKEND_SENTRY_DSN=

# Белый список email через запятую — у кого есть доступ к /admin/tickets
# (ответы на заявки в поддержку, см. stats-backend/server.js). Email —
# это именно email аккаунта Extree Stats (email+пароль), а не Apple ID
# или что-то ещё. Пусто — админка недоступна никому.
SUPPORT_ADMIN_EMAILS=

# Resend (utils/email.js) — транзакционные письма бота (не Extree Stats,
# у того своя почта через iCloud, см. STATS_MAIL_* выше), отправитель
# no-reply@extree.tech. Ключ — на resend.com → API Keys.
RESEND_API_KEY=
