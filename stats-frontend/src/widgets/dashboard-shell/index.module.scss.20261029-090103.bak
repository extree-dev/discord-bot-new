.shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
}

/* === Топбар (Хедер) === */
.topbar {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 0 24px;
    height: 60px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(var(--bg-rgb), 0.72);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));

    @media (max-width: 960px) {
        padding: 0 16px;
        gap: 16px;
    }
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;

    span {
        color: var(--text);
        font-size: 14.5px;
        font-weight: 700;
        letter-spacing: -0.01em;

        @media (max-width: 560px) {
            display: none;
        }
    }
}

.mark {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-sm);
    object-fit: cover;
}

/* Десктопное меню */
.navLinks {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;

    @media (max-width: 960px) {
        display: none;
    }
}

.navLink {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-faint);
    text-decoration: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: color 0.15s ease;

    svg {
        flex-shrink: 0;
        width: 17px;
        height: 17px;
    }

    &:hover {
        color: var(--text);
    }

    &.active {
        color: var(--text);
        border-bottom-color: var(--accent);
    }
}

.topbarRight {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}

.userChip {
    display: flex;
    align-items: center;
    gap: 8px;

    @media (max-width: 960px) {
        display: none;
    }
}

.userEmail {
    font-size: 12.5px;
    color: var(--text-faint);
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    @media (max-width: 1180px) {
        display: none;
    }
}

.iconBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: none;
    border: 1px solid transparent;
    color: var(--text-faint);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;

    svg {
        width: 16px;
        height: 16px;
    }

    &:hover {
        color: var(--accent-soft);
        border-color: var(--border-strong);
    }

    @media (max-width: 960px) {
        display: none;
    }
}

/* Выпадающее меню админа */
.adminMenu {
    position: relative;
}

.iconBtnActive {
    color: var(--accent-soft);
    border-color: var(--border-strong);
}

.adminDropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 200px;
    display: flex;
    flex-direction: column;
    padding: 6px;
    background: var(--glass-menu-bg);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    box-shadow: var(--glass-shadow);
    z-index: 60;
    animation: admin-dropdown-in 0.15s var(--ease-out) both;
}

.adminDropdownItem {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-dim);
    text-decoration: none;

    svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    &:hover {
        background: var(--surface-2);
        color: var(--text);
    }

    &.active {
        color: var(--accent-soft);
        svg { color: var(--accent-soft); }
    }
}

@keyframes admin-dropdown-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
    .adminDropdown { animation: none; }
}

.menuToggle {
    display: none;

    @media (max-width: 960px) {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-sm);
        background: none;
        border: 1px solid var(--border-strong);
        color: var(--text);
        cursor: pointer;
    }
}

/* Мобильное меню */
.menuBackdrop {
    position: fixed;
    inset: 0;
    top: 60px;
    z-index: 55;
    background: rgba(0, 0, 0, 0.7);
}

.mobileMenu {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    z-index: 56;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 16px calc(16px + env(safe-area-inset-bottom));
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    max-height: calc(100vh - 60px);
    overflow-y: auto;

    .navLink {
        padding: 12px 10px;
        font-size: 14.5px;
        border-bottom: none;
        border-radius: var(--radius-sm);

        &.active {
            background: var(--surface-2);
            color: var(--accent);
        }

        &:hover {
            background: var(--surface-2);
        }
    }
}

.navLabel {
    margin: 14px 10px 4px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
}

/* Контент */
.main {
    flex: 1;
    padding: 36px 24px calc(48px + env(safe-area-inset-bottom));

    @media (max-width: 960px) {
        padding: 24px 16px calc(32px + env(safe-area-inset-bottom));
    }
}

.content {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.contentWide {
    max-width: 1100px;
}

.pageHead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 4px;
}

.breadcrumb {
    display: block;
    margin-bottom: 10px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-faint);
    text-decoration: none;

    &:hover { color: var(--text-dim); }
}

.pageTitle {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.025em;
}

.pageSubtitle {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--text-faint);
}

.error {
    padding: 13px 18px;
    border-radius: var(--radius-sm);
    background: rgba(255, 59, 78, 0.1);
    border: 1px solid rgba(255, 59, 78, 0.3);
    color: var(--accent-soft);
    font-size: 13px;
    line-height: 1.5;
}

/* Мобильная адаптация для контента */
@media (max-width: 768px) {
    .main {
        padding: 16px !important;
    }
    .pageHead {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
}