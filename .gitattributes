# Auto-detect text files and normalize line endings
* text=auto

# Source — LF
*.java  text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.sass  text eol=lf
*.less  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.properties text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.vue   text eol=lf
*.svelte text eol=lf

# Windows-only
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binaries
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary